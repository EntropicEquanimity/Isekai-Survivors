/* The Legacy tree window (Blondie Skill Trees) in the game's look: solid, with wide named nodes (no icons yet). */

.blondie-skills-window {
    background-color: rgb(18, 20, 26);
}

/* Name on the left, rank on the right, both inside the node: lines run between nodes, never through text. */
.blondie-pixel .blondie-skills-node {
    width: 128px;
    height: 20px;
    margin-left: -64px;
    margin-top: -10px;
    align-items: flex-start;
}

.blondie-pixel .blondie-skills-node__name {
    white-space: nowrap;
    padding: 0 0 0 4px;
    margin: 0;
    -unity-text-align: middle-left;
}

.blondie-pixel .blondie-skills-node__rank {
    top: 0;
    bottom: 0;
    right: 4px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-right;
}

.blondie-skills-respec {
    background-color: rgb(52, 56, 70);
    border-color: rgb(90, 94, 110);
    color: rgb(230, 230, 235);
}

.blondie-skills-respec:hover {
    background-color: rgb(70, 74, 92);
}

/* Locked nodes are solid and greyed, never see-through (lines would show through their names). */
.blondie-skills-node--locked {
    opacity: 1;
    background-color: rgb(26, 27, 33);
    border-color: rgb(58, 60, 70);
}

.blondie-skills-node--locked .blondie-skills-node__name,
.blondie-skills-node--locked .blondie-skills-node__rank {
    color: rgb(110, 112, 125);
}
